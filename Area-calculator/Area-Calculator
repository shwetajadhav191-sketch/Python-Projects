import math

print("""=====================
   Area Calculator
=====================\n""")

print("1. Triangle")
print("2. Rectangle")
print("3. Square")
print("4. Circle")
print("5. Quit")

shape = int(input("\nWhich Shape: "))

if shape == 1:
    height = float(input("\nHeight: "))
    base = float(input("base: "))
    area = (height*base)/2
    print("\nArea of triangle is ",area)
elif shape == 2:
    length = float(input("\nlength: "))
    width = float(input("width: "))
    area = length*width
    print("\nArea of Rectangle is ",area)
elif shape == 3:
    side = float(input("\nside: "))
    area = side*side
    print("\nArea of Square is ",area)
elif shape == 4:
    radius = float(input("\nradius: "))
    pi = math.pi
    area = pi*(radius*radius)
    print("\nArea of circle is ",area)
elif shape == 5:
    print("\nQuit.")
else:
    print("\nInvalid Input!")    
